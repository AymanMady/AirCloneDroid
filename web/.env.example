# ─────────────────────────────────────────────────────────────────────────────
# MyRemoteDroid — configuration (toutes les variables sont OPTIONNELLES)
# ─────────────────────────────────────────────────────────────────────────────

# Mode démonstration : affiche des données d'exemple, sans téléphone.
#   1 = forcer la démo · 0 = forcer le vrai mode · (vide) = auto
# Auto : la démo s'active toute seule sur Vercel quand aucun PHONE_HOST n'est défini.
DEMO_MODE=

# Connexion à un vrai téléphone (vrai mode).
# En local, laissez vide et configurez via l'interface (modale « Paramètres »).
# Sur un serveur (ex. Vercel), le téléphone doit être JOIGNABLE depuis le serveur
# (même réseau, ou via un tunnel public — voir README « Déploiement »).
PHONE_HOST=
PHONE_PORT=7575
PHONE_PIN=
